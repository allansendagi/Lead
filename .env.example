# Supabase — get these from your Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here   # Settings → API → service_role (keep secret)

# WhatsApp Business number — digits only, include country code, no + or spaces
# Example Qatar: 97450000000 | Example UK: 447911123456
WHATSAPP_NUMBER=97450000000

# Optional: restrict API to your Vercel domain (recommended in production)
# ALLOWED_ORIGIN=https://your-app.vercel.app

# Resend — sends the reservation confirmation email (buyer) and the
# admin notification email when someone reserves a seat
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=allan@safehavenai.world

# Optional — where the admin notification goes. Defaults to
# allan@safehavenai.world if not set.
# RESERVATION_NOTIFY_EMAIL=allan@safehavenai.world
