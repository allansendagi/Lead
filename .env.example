# Supabase — get these from your Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here   # Settings → API → service_role (keep secret)

# WhatsApp Business number — digits only, include country code, no + or spaces
# Example Qatar: 97450000000 | Example UK: 447911123456
WHATSAPP_NUMBER=97450000000

# Optional: restrict API to your Vercel domain (recommended in production)
# ALLOWED_ORIGIN=https://your-app.vercel.app

# Paddle — client-side token from Paddle > Developer tools > Authentication
# (safe to expose — this is NOT the server-side API key)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_token_here
NEXT_PUBLIC_PADDLE_ENV=sandbox   # or "production"
NEXT_PUBLIC_PADDLE_WORKSHOP_PRICE_ID=pri_your_price_id_here

# Paddle webhook — from Paddle > Developer tools > Notifications, after you
# add a destination pointing at https://<your-domain>/api/paddle-webhook
PADDLE_WEBHOOK_SECRET=ntfset_your_webhook_secret_here

# Resend — sends the post-payment confirmation email
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=allan@safehavenai.world
